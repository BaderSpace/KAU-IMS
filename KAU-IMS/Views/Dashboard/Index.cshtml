@model List<KAU_IMS.Models.Application>

@{
    ViewData["Title"] = "Dashboard";
    var user = ViewBag.User as KAU_IMS.Models.User;
}

@section Styles {
    <style>
        .dashboard-container {
            padding: 40px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .welcome-section {
            background: linear-gradient(135deg, #0f62fe, #6f7dff);
            color: white;
            padding: 30px;
            border-radius: 8px;
            margin-bottom: 30px;
        }
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: #0b1736;
            color: white;
            padding: 20px;
            border-radius: 8px;
            border: 2px solid #0f62fe;
        }
        .applications-table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 8px;
            overflow: hidden;
        }
        .applications-table th {
            background: #0f62fe;
            color: white;
            padding: 15px;
            text-align: left;
        }
        .applications-table td {
            padding: 15px;
            border-bottom: 1px solid #e5e7eb;
        }
        .applications-table tr:hover {
            background: #f9fafb;
        }
        .status-badge {
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }
        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }
        .status-accepted {
            background: #d1fae5;
            color: #065f46;
        }
        .status-rejected {
            background: #fee2e2;
            color: #991b1b;
        }
        .btn-delete {
            background: #dc2626;
            color: white;
            padding: 5px 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }
        .btn-delete:hover {
            background: #b91c1c;
        }
    </style>
}

<div class="dashboard-container">
    <div class="welcome-section">
        <h1>Welcome, @user?.FirstName @user?.LastName!</h1>
        <p>Email: @user?.Email</p>
        @if (ViewBag.LastLogin != null)
        {
            <p>Last Login: @ViewBag.LastLogin</p>
        }
    </div>

    <div class="stats-container">
        <div class="stat-card">
            <h3>Total Applications</h3>
            <h2 style="color: #8eb3fd; font-size: 36px;">@ViewBag.ApplicationCount</h2>
        </div>
        <div class="stat-card">
            <h3>Account Created</h3>
            <p>@user?.CreatedAt.ToString("MMM dd, yyyy")</p>
        </div>
        <div class="stat-card">
            <h3>Quick Actions</h3>
            <p>
                <a href="@Url.Action("Index", "Internship")" class="btn primary">Browse Internships</a>
            </p>
        </div>
    </div>

    <section style="background: white; padding: 30px; border-radius: 8px;">
        <h2 style="margin-bottom: 20px; color: #0f62fe;">My Applications</h2>
        
        @if (Model != null && Model.Any())
        {
            <table class="applications-table">
                <thead>
                    <tr>
                        <th>Internship Title</th>
                        <th>Company</th>
                        <th>Applied Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var application in Model)
                    {
                        <tr>
                            <td>
                                <strong>@application.Internship?.Title</strong>
                            </td>
                            <td>@application.Internship?.Company</td>
                            <td>@application.AppliedDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="status-badge status-@application.Status.ToLower()">
                                    @application.Status
                                </span>
                            </td>
                            <td>
                                <form method="post" asp-action="DeleteApplication" asp-controller="Dashboard" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@application.Id" />
                                    <button type="submit" class="btn-delete" onclick="return confirm('Are you sure you want to delete this application?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="card" style="text-align: center; padding: 40px;">
                <h3>No Applications Yet</h3>
                <p>Start browsing internships and apply to opportunities that match your skills!</p>
                <a href="@Url.Action("Index", "Internship")" class="btn primary">Browse Internships</a>
            </div>
        }
    </section>
</div>
