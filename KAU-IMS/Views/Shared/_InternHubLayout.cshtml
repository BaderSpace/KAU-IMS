@{
    var title = ViewData["Title"] as string ?? "InternHub";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - InternHub</title>
    <link rel="stylesheet" href="~/css/internhub.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div style="font-weight: bold; font-size: 25px; padding-left: 20%;">InternHub</div>
        <nav>
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Login">Login</a>
            <a asp-controller="Home" asp-action="SignUp">Sign-up</a>
            <a asp-controller="Home" asp-action="AboutUs">About Us</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        <div style="font-weight: bold; font-size: 20px; padding-left: 20%;">InternHub</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
