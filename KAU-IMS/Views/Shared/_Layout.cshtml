<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InternHub</title>
    <link rel="stylesheet" href="~/css/style.css" />
    <style>
        /* Internal CSS for additional styling */
        .alert {
            padding: 15px;
            margin-bottom: 20px;
            border: 1px solid transparent;
            border-radius: 4px;
        }
        .alert-success {
            color: #155724;
            background-color: #d4edda;
            border-color: #c3e6cb;
        }
        .alert-danger {
            color: #721c24;
            background-color: #f8d7da;
            border-color: #f5c6cb;
        }
        .alert-info {
            color: #0c5460;
            background-color: #d1ecf1;
            border-color: #bee5eb;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <div style="font-weight: bold; font-size: 25px; padding-left: 20%;">
            <a href="/" style="color: white; text-decoration: none;">InternHub</a>
        </div>
        <nav>
            <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "current" : "")" 
               href="@Url.Action("Index", "Home")">Home</a>
            
            @if (Context.Session.GetString("UserId") != null)
            {
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Internship" ? "current" : "")" 
                   href="@Url.Action("Index", "Internship")">Internships</a>
                <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "current" : "")" 
                   href="@Url.Action("Index", "Dashboard")">Dashboard</a>
                <a href="@Url.Action("Logout", "Account")">Logout</a>
            }
            else
            {
                <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Login" ? "current" : "")" 
                   href="@Url.Action("Login", "Account")">Login</a>
                <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Signup" ? "current" : "")" 
                   href="@Url.Action("Signup", "Account")">Sign-up</a>
            }
            
            <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "current" : "")" 
               href="@Url.Action("About", "Home")">About Us</a>
        </nav>
    </header>

    <main role="main">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" style="margin: 20px;">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="margin: 20px;">
                @TempData["ErrorMessage"]
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info" style="margin: 20px;">
                @TempData["InfoMessage"]
            </div>
        }
        
        @RenderBody()
    </main>

    <footer>
        <div style="font-weight: bold; font-size: 20px; padding-left: 20%;">InternHub</div>
        <div style="padding-right: 20%;">
            &copy; @DateTime.Now.Year - KAU Internship Management System
        </div>
    </footer>

    <script src="~/js/formValid.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
