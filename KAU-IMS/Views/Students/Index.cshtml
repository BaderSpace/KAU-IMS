@model IEnumerable<KAU_IMS.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.stu_name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.stu_email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.stu_phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.stu_GDP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.stu_specialty)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.stu_gender)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.stu_name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.stu_email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.stu_phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.stu_GDP)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.stu_specialty)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.stu_gender)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.stu_Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.stu_Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.stu_Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
