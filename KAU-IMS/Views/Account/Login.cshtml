@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <style>
        input { margin: 5%;}
        .user-type-selector {
            margin: 20px 0;
            text-align: center;
        }
        .user-type-selector label {
            margin: 0 15px;
            color: white;
            font-size: 16px;
        }
    </style>
}

<section class="credentials-section">
    <div class="credentials-container">
        <form method="post" asp-action="Login" asp-controller="Account">
            @Html.AntiForgeryToken()
            <h1>Login</h1>
            
            <div class="user-type-selector">
                <label>
                    <input type="radio" name="userType" value="student" checked /> Student
                </label>
                <br />
                <label>
                    <input type="radio" name="userType" value="company" /> Company
                </label>
            </div>

            <p>
                <label>
                    Email: 
                    <input type="email" name="Email" placeholder="Enter your E-mail" required />
                </label>
                <br>
                <label>
                    Password: 
                    <input type="password" name="Password" placeholder="Enter your Password" required />
                </label>
            </p>
            <p>
                <input type="submit" value="Login" />
            </p>
            <p style="color: white; font-size: 14px;">
                Don't have an account? 
                <a href="@Url.Action("Signup", "Account")" style="color: #8eb3fd;">Student Sign up</a> | 
                <a href="@Url.Action("CompanySignup", "Account")" style="color: #8eb3fd;">Company Sign up</a>
            </p>
        </form>
    </div>
</section>
