@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <style>
        .text-container p {margin-bottom: 4%;}
    </style>
}

<section class="top-section">
    <div class="text-container">
        <h1>For Students</h1>
        <p>Browse internships and training matched to your skills and completed subjects—fast and simple.</p>
        <a class="btn primary" href="@Url.Action("Signup", "Account")">Get Started</a>
    </div>
    <div class="text-container">
        <h1>For Companies</h1>
        <p>Post internships in minutes and reach qualified students who match your required skills.</p>
        <a class="btn outline" href="@Url.Action("CompanySignup", "Account")">List your company</a>
    </div>
</section>

<section class="info-section">
    <h2 style="border: 1px solid #0f62fe; border-radius: 40px; padding: 5px; width: fit-content;">Why InternHub?</h2>
    <div class="card">
        <h2>Skill-based matching</h2>
        <p>See internships that align with your actual skills and completed courses.</p>
    </div>
    <div class="card">
        <h2>Wide opportunities</h2>
        <p>Explore roles across development, data, UI/UX, IT support, and more.</p>
    </div>
    <div class="card">
        <h2>Simple applications</h2>
        <p>Apply in a few clicks and track your status in one place.</p>
    </div>
</section>

<div style="justify-items: center; align-items: center; text-align: center; margin-bottom: 10px;">
    <img src="~/images/InternHub.png" width="150px" height="150px" alt="InternHub Logo">
</div>
